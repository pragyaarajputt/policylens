# Copy to .env and fill in. Never commit .env.

# Postgres. Locally any Postgres 16+; in production a Neon pooled URL (+ the direct URL for migrations).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/policylens"
DATABASE_URL_UNPOOLED=""
# Integration tests. Must name a *_test database; it is wiped on every run.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/policylens_test"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=""
# Passwordless email login for local development only. Ignored in production builds.
AUTH_DEV_LOGIN="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Gemini (free tier: https://aistudio.google.com/apikey). Use a paid key before real users:
# on the free tier Google may use inputs to improve its products.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# Number of proxies in front of the app (Vercel/Render: 1), for rate limits.
TRUSTED_PROXY_HOPS="1"
